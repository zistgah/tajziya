REM @@NODE@@.pni: one sourced batch for the @@NODE@@ module.
REM © 1993–2026 Abhishek Choudhary. All rights reserved. AyeAI.

CYCLER @@CYCLER@@
  TITLE   "One batch for @@NAME@@"
  SCRIPT  "تجزیہ"
  OUTPUT  RESEARCH
  UNIT    "batch"
  PURPOSE "Bring one coherent batch of rules for @@NODE@@ from a citable, openly licensed source into tested code."

  CONTRACT
    REFUSE    "a rule without a source"
    REFUSE    "a source under a licence the module may not carry"
    REFUSE    "a disagreement between sources resolved without a record"
    INVARIANT "every layer not built refuses by name"
    EVIDENCE  "bash accept.sh, pasted verbatim"
  END CONTRACT

  STAGE CONCEPT
    RESOLUTION EASY
    VERB   CREATE
    EXPECT JSON
    INTO   batch
    ASK
      I am adding one batch of rules to the tajziya module for @@NODE@@ (@@NAME@@).
      Reply with only this JSON:
      {"layer":"L3s or another layer id","batch":"one section or one rule type","engine":"an id from registry/engines.json"}
      What I have so far:
      {seed}
    END ASK
    VALIDATE HAS(batch, "engine")
    ON FAIL CLARIFY
  END STAGE

  STAGE SOURCE
    RESOLUTION MID
    VERB   VERIFY
    EXPECT JSON
    FROM   batch
    INTO   batch.source
    ASK
      Take the batch from a real, citable edition. Record the URL, the retrieval date, the
      SHA-256 of what was retrieved, and its licence. Only a licence in registry/licences.json
      may enter the module; restricted material stays in data/local/, pinned and never committed.
    END ASK
  END STAGE

  STAGE CROSSCHECK
    RESOLUTION MID
    VERB   VERIFY
    EXPECT JSON
    FROM   batch
    INTO   batch.disagreements
    ASK
      Where more than one source covers these rules, list every disagreement in numbering,
      wording or classification. Record both readings and state which one the module follows,
      with the reason.
    END ASK
  END STAGE

  STAGE IMPLEMENT
    RESOLUTION PRO
    VERB   CREATE
    EXPECT TEXT
    FROM   batch
    INTO   batch.change
    ASK
      Implement the batch in python/@@IMPL@@/__init__.py, importing only tajziya.api. Set the
      layer's state in module.json, and name what it leaves out in scope_excludes.
    END ASK
  END STAGE

  STAGE TEST
    RESOLUTION PRO
    VERB   EXECUTE
    EXPECT TEXT
    FROM   batch
    INTO   batch.tests
    ASK
      Add attested examples from the source to reference/examples.json, each with its locator,
      giving every reading the source admits. Run bash accept.sh and paste its output verbatim.
    END ASK
    GATE   HUMAN "BATCH accepted"
  END STAGE
END CYCLER
